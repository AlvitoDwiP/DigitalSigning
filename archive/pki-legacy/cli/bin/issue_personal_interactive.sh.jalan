#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
trap 'echo "❌ Terjadi error pada baris $LINENO"; exit 1' ERR

# =======================
#  PUSTIK MKRI – Issuer (Personal + Org info) via Intermediate CA
#  Hasil: key, csr, crt, pfx (+ compat p12)
# =======================

# ---- Cek OpenSSL ----
command -v openssl >/dev/null 2>&1 || { echo "ERROR: openssl tidak ditemukan di PATH"; exit 1; }

# ---- Default (bisa diubah) ----
DEFAULT_H="/home/belalangtempur"
DEFAULT_ORG_SLUG="univ-b"
DEFAULT_ORG_NAME="Universitas B"
DEFAULT_OU="TTE"
DEFAULT_CN="Nama Penandatangan"
DEFAULT_EMAIL="penandatangan@univ-b.ac.id"
DEFAULT_DAYS="730"
DEFAULT_PFX_PASS="PfxPass!ChangeMe123"

echo "==> Base path H menentukan lokasi pki (default: ${DEFAULT_H})"
read -r -p "Base path H [${DEFAULT_H}]: " H
H="${H:-$DEFAULT_H}"

INT_DIR="$H/pki/intermediate"
INT_CNF="$INT_DIR/openssl.cnf"
CHAIN="$INT_DIR/certs/ca-chain.crt"
EXTFILE="$INT_DIR/pdfsign-ext.cnf"
INTER_KEY="$INT_DIR/private/intermediate-ca.key"

read -r -p "ORG_SLUG (folder/nama file) [${DEFAULT_ORG_SLUG}]: " ORG_SLUG
ORG_SLUG="${ORG_SLUG:-$DEFAULT_ORG_SLUG}"

read -r -p "ORG_NAME (O=...) [${DEFAULT_ORG_NAME}]: " ORG_NAME
ORG_NAME="${ORG_NAME:-$DEFAULT_ORG_NAME}"

read -r -p "OU (OU=...) [${DEFAULT_OU}]: " OU
OU="${OU:-$DEFAULT_OU}"

read -r -p "Nama personal / CN [${DEFAULT_CN}]: " CN
CN="${CN:-$DEFAULT_CN}"

read -r -p "Email personal [${DEFAULT_EMAIL}]: " EMAIL
EMAIL="${EMAIL:-$DEFAULT_EMAIL}"

read -r -p "Masa berlaku (hari) [${DEFAULT_DAYS}]: " DAYS
DAYS="${DAYS:-$DEFAULT_DAYS}"

# ---- Password Intermediate CA (dipakai saat openssl ca) ----
if [[ -n "${INTER_CA_PASS:-}" ]]; then
  echo "INFO: INTER_CA_PASS terdeteksi dari ENV (akan digunakan)."
else
  read -s -r -p "Password Intermediate CA (INTER_CA_PASS) [wajib]: " INTER_CA_PASS
  echo
  [[ -n "$INTER_CA_PASS" ]] || { echo "ERROR: INTER_CA_PASS wajib diisi."; exit 1; }
fi

# ---- Password PFX output ----
read -s -r -p "Password PFX (untuk file .pfx/.p12) [kosong=${DEFAULT_PFX_PASS}]: " PFX_PASS
echo
PFX_PASS="${PFX_PASS:-$DEFAULT_PFX_PASS}"

# ---- Validasi file CA ----
[[ -f "$INT_CNF" ]] || { echo "ERROR: $INT_CNF tidak ada. Pastikan intermediate CA siap."; exit 1; }
[[ -f "$CHAIN"  ]] || { echo "ERROR: $CHAIN tidak ada (gabungan intermediate+root)."; exit 1; }
[[ -f "$INTER_KEY" ]] || { echo "ERROR: $INTER_KEY tidak ada."; exit 1; }

# ---- Validasi password Intermediate CA lebih dulu (biar gagal di awal) ----
if ! openssl pkey -in "$INTER_KEY" -passin "pass:$INTER_CA_PASS" -noout >/dev/null 2>&1; then
  echo "ERROR: Password Intermediate CA salah atau key tidak bisa dibaca: $INTER_KEY"
  exit 1
fi

# ---- Folder output ----
ISSUED_DIR="$H/pki/issued/$ORG_SLUG"
mkdir -p "$ISSUED_DIR"

# ---- Tulis ekstensi end-entity untuk PDF signing (idempotent) ----
cat > "$EXTFILE" <<'EOF'
[pdfsign]
basicConstraints = critical, CA:false
keyUsage         = critical, digitalSignature, nonRepudiation
extendedKeyUsage = emailProtection, clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid,issuer
# salin email dari subject ke SAN agar kompatibel
subjectAltName         = email:copy
EOF

# ---- Trim CN ke maks 64 char (batas X.509) ----
CN_ORIG="$CN"
CN_LEN=$(printf '%s' "$CN" | wc -m | tr -d ' ')
if [ "$CN_LEN" -gt 64 ]; then
  CN=$(printf '%s' "$CN" | cut -c1-64)
  echo "WARN: CN terlalu panjang ($CN_LEN) → dipotong 64: \"$CN\""
  echo "      (Friendly name PFX tetap pakai nama lengkap)"
fi

# ---- Peringatan email tidak valid (tidak memblok) ----
if ! printf '%s' "$EMAIL" | grep -Eq '.+@.+\..+'; then
  echo "WARN: Format email tampaknya tidak valid: \"$EMAIL\""
fi

# ---- Escape '/' dalam nilai subject ----
escape_slash() { printf '%s' "$1" | sed 's,/,\\/,g'; }
CN_ESC=$(escape_slash "$CN")
ORG_ESC=$(escape_slash "$ORG_NAME")
OU_ESC=$(escape_slash "$OU")
EMAIL_ESC=$(escape_slash "$EMAIL")

echo
echo "==> Ringkasan input:"
echo "    CN      : $CN_ORIG"
echo "    Email   : $EMAIL"
echo "    O/OU    : $ORG_NAME / $OU"
echo "    Folder  : $ISSUED_DIR"
echo "    Berlaku : $DAYS hari"
echo "    (Password CA yang dipakai: INTER_CA_PASS – Intermediate CA)"
echo "    (Password PFX output     : PFX_PASS)"
echo

KEY="$ISSUED_DIR/$ORG_SLUG.key"
CSR="$ISSUED_DIR/$ORG_SLUG.csr"
CRT="$ISSUED_DIR/$ORG_SLUG.crt"
PFX="$ISSUED_DIR/$ORG_SLUG.pfx"
P12="$ISSUED_DIR/$ORG_SLUG-compat.p12"

# ---- Jika file sudah ada, konfirmasi overwrite ----
for f in "$KEY" "$CSR" "$CRT" "$PFX" "$P12"; do
  if [[ -f "$f" ]]; then
    read -r -p "File sudah ada: $f — overwrite? [y/N]: " ans
    ans="${ans:-N}"
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "Dibatalkan."; exit 1; }
    break
  fi
done

# ---- 1) PRIVATE KEY (RSA 3072) ----
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "$KEY"
chmod 600 "$KEY"

# ---- 2) CSR (Subject personal + org info; SAN: email:copy) ----
SUBJ="/C=ID/O=$ORG_ESC/OU=$OU_ESC/CN=$CN_ESC/emailAddress=$EMAIL_ESC"
openssl req -new \
  -key "$KEY" \
  -out "$CSR" \
  -subj "$SUBJ" \
  -addext "subjectAltName = email:copy"

# ---- 3) SIGN CSR via Intermediate CA ----
openssl ca -config "$INT_CNF" \
  -in  "$CSR" \
  -out "$CRT" \
  -extensions pdfsign -extfile "$EXTFILE" \
  -days "$DAYS" -batch -passin "pass:$INTER_CA_PASS"

# ---- 4) VERIFY chain ----
openssl verify -CAfile "$CHAIN" "$CRT"

# ---- 5) EXPORT PFX (modern) ----
FRIENDLY="${CN_ORIG:-$CN} – $ORG_NAME (TTE)"
openssl pkcs12 -export \
  -inkey   "$KEY" \
  -in      "$CRT" \
  -certfile "$CHAIN" \
  -name    "$FRIENDLY" \
  -passout "pass:$PFX_PASS" \
  -out     "$PFX"

# ---- 5b) EXPORT P12 (legacy 3DES) opsional ----
openssl pkcs12 -export \
  -inkey   "$KEY" \
  -in      "$CRT" \
  -certfile "$CHAIN" \
  -name    "$FRIENDLY" \
  -passout "pass:$PFX_PASS" \
  -legacy -keypbe PBE-SHA1-3DES -certpbe PBE-SHA1-3DES -macalg sha256 \
  -out     "$P12"

echo
ls -lh "$KEY" "$CSR" "$CRT" "$PFX" 2>/dev/null || true
ls -lh "$P12" 2>/dev/null || true
echo
echo "SELESAI ✅"
echo "Friendly name PFX : $FRIENDLY"
echo "Password PFX      : $PFX_PASS"
echo "Output dir        : $ISSUED_DIR"
echo
echo "Catatan:"
echo " - INTER_CA_PASS = password private key Intermediate CA (dipakai saat 'openssl ca')."
echo " - ROOT_CA_PASS  TIDAK dipakai di skrip ini (root hanya untuk menandatangani Intermediate)."

