# ==============================================================================
# PRODUCTION FRONTEND DOCKERFILE WITH HTTPS REVERSE PROXY & AUTOMATED SSL SETUP
# ==============================================================================

# Stage 1: Build React SPA
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

COPY frontend/ ./
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Stage 2: Hardened Nginx Production Web Server
FROM nginx:alpine

# Install openssl for entrypoint cert validation
RUN apk add --no-cache openssl

# Copy production Nginx reverse proxy configuration
COPY docker/nginx-prod.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy SSL initialization entrypoint script
COPY docker/init_ssl_certs.sh /docker-entrypoint-ssl.sh
RUN chmod +x /docker-entrypoint-ssl.sh

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint-ssl.sh"]
CMD ["nginx", "-g", "daemon off;"]

