# Environment Configuration Template
# Digital Signature Platform - Phase 1

# Database Configuration (PostgreSQL)
# For local Mac Homebrew PostgreSQL via socket: postgresql://@/digital_signature_db?host=/opt/homebrew/var/postgresql@16
# For TCP/Docker: postgresql://postgres:postgres@localhost:5432/digital_signature_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_signature_db

# Security & Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PKI Service Integration
PKI_SERVICE_URL=http://localhost:8001
PKI_SERVICE_TOKEN=change-this-pki-service-secret-token
PKI_TIMEOUT=30

# Application Environment
ENVIRONMENT=development
PORT=8000
