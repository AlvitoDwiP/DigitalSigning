# Environment Configuration Template
# Digital Signature Platform - Phase 1 (Monolith API)

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=digital_signature_db

# In Docker Network:
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/digital_signature_db
# For Local Host development outside docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/digital_signature_db

# Security & Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Application Environment
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PKI Engine Configuration
PKI_ENGINE_DIR=/app/pki/scripts
P12_ARCHIVE_DIR=/app/sign-api/p12
