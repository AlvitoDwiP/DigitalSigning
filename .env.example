# Environment Configuration Template
# Digital Signature Platform - Phase 1

# Database Configuration (PostgreSQL)
# In Docker Network: postgresql://postgres:postgrespassword@postgres:5432/digital_signature_db
# For Local Host development: postgresql://postgres:postgrespassword@localhost:5432/digital_signature_db
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/digital_signature_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=digital_signature_db

# Security & Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PKI Service Integration
PKI_SERVICE_URL=http://pki-service:8001
PKI_SERVICE_TOKEN=change-this-pki-service-secret-token
PKI_TIMEOUT=30

# Application Environment
ENVIRONMENT=development
PORT=8000

# Frontend Configuration
VITE_API_URL=http://backend:8000
