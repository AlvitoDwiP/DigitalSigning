# Environment Configuration Template
# Digital Signature Platform - 3-Container Application Architecture (Postgres, PKI Service, Backend)

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=digital_signature_db

# In Docker Network:
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/digital_signature_db
# For Local Host development outside docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/digital_signature_db

# Security & Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Application Environment
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# PKI Service Internal Communication (Antar-Container)
PKI_SERVICE_URL=http://pki_service:8001
PKI_SERVICE_TOKEN=dev-internal-pki-secret-token-2026
PKI_PORT=8001

# PKI Storage & Engine Configuration
PKI_ENGINE_DIR=/app/pki/scripts
P12_ARCHIVE_DIR=/app/sign-api/p12

# PKI Service Secret (HANYA digunakan oleh PKI Service, Backend TIDAK memiliki akses)
# Password Private Key Intermediate CA (Wajib diganti untuk produksi)
INTER_CA_PASS=InterPass!ChangeMe123

# Nilai default passphrase pfx dan user (aturan bisnis institusi)
DEFAULT_PFX_PASS=Mkri006!
DEFAULT_USER_PASS=Konstitusi100%
