# Environment Configuration Template
# Digital Signature Platform - 3-Container Application Architecture (Postgres, PKI Service, Backend)

# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL) - [WAJIB UNTUK PRODUCTION]
# ==============================================================================
POSTGRES_USER=postgres
# Ganti dengan password yang kuat dan unik pada environment produksi:
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=digital_signature_db

# Digunakan oleh Backend API untuk koneksi database:
# Di dalam Docker Network internal:
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@postgres:5432/digital_signature_db
# Untuk development lokal langsung pada Host OS:
# DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/digital_signature_db

# ==============================================================================
# 2. APPLICATION SECURITY & SECRETS - [WAJIB UNTUK PRODUCTION]
# ==============================================================================
# Secret key untuk penandatanganan JWT sesi auth (minimal 32 karakter acak):
SECRET_KEY=generate_a_random_32_plus_char_secret_key_for_production

# Environment Mode: 'development' | 'production' | 'testing'
# Pada mode 'production', aplikasi akan menolak secret/token default secara fatal:
ENVIRONMENT=development
PORT=8000

# CORS Origins (pisahkan dengan koma). Wildcard '*' dilarang keras pada mode production:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# 3. INTERNAL PKI COMMUNICATION - [WAJIB UNTUK PRODUCTION]
# ==============================================================================
# URL internal PKI Service (hanya diakses oleh container Backend via Docker network):
PKI_SERVICE_URL=http://pki_service:8001
PKI_PORT=8001

# Shared bearer token internal (minimal 32 karakter acak). Nilai dev ini ditolak di production:
PKI_SERVICE_TOKEN=generate_a_random_32_plus_char_pki_token_for_production

# ==============================================================================
# 4. PKI STORAGE & ENGINE PATHS - [OPSIONAL / SYSTEM DEFAULTS]
# ==============================================================================
PKI_ENGINE_DIR=/app/pki/scripts
P12_ARCHIVE_DIR=/app/sign-api/p12

# ==============================================================================
# 5. PKI SERVICE SECRETS - [WAJIB UNTUK PRODUCTION, HANYA CONTAINER PKI]
# ==============================================================================
# Passphrase untuk decrypt private key Intermediate CA (HANYA dibaca oleh PKI Service).
# Backend TIDAK memiliki akses ke variabel ini. Nilai default ini ditolak keras di production:
INTER_CA_PASS=your_strong_intermediate_ca_passphrase_here

# ==============================================================================
# 6. BUSINESS LOGIC DEFAULTS - [OPSIONAL / ATURAN BISNIS INSTITUSI]
# ==============================================================================
# Default passphrase provisioning sertifikat jika admin tidak menentukan passphrase khusus:
DEFAULT_PFX_PASS=Mkri006!
# Default password akun user baru sebelum diganti mandiri oleh pengguna:
DEFAULT_USER_PASS=Konstitusi100%

# ==============================================================================
# 7. FEATURE FLAGS (PHASE 1 vs PHASE 2)
# ==============================================================================
# Fitur penandatanganan PDF (TTE) dijadwalkan untuk Phase 2 (default: false pada Phase 1):
ENABLE_PDF_SIGNING=false
