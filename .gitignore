# PKI Private Keys, Secrets & Backups (Sangat Rahasia)
# ==========================================
*.key
*.pem
*.csr
*.p12
*.pfx
*-meta.txt
*.old
*.bak

# Direktori Privat & Database CA Runtime
**/private/
**/newcerts/
**/backup/
pki/root/private/
pki/intermediate/private/
pki/intermediate/backup/
pki/root/backup/
pki/issued/
pki/issued/.staging_*
pki/bk.issued/
pki/uploads/
pki/p12/
.staging_*

# User Certificates Bundles & Runtime P12 Archives
sign-api/p12/
sign-api/bk.p12/
sign-api(well3)/p12/
sign-api(well3)/bk.p12/
archive/pki-legacy/issued-prelaunch/
archive/pki-legacy/backups/*.csv

# Kecualikan Sertifikat Publik CA (Aman dipush untuk verifikasi trust)
!pki/root/certs/root-ca.crt
!pki/intermediate/certs/intermediate-ca.crt
!pki/intermediate/certs/ca-chain.crt

